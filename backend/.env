######################################
### SESSION
######################################
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:3001,127.0.0.1,portfolio.test,api.portfolio.test
SESSION_DOMAIN=.portfolio.test

SESSION_DRIVER=redis
SESSION_LIFETIME=180
SESSION_EXPIRE_ON_CLOSE=false
SESSION_PATH=/
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

######################################
### XDEBUG
######################################
SAIL_XDEBUG_MODE=debug,develop
SAIL_XDEBUG_CONFIG="client_host=host.docker.internal idekey=PHPSTORM"

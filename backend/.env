######################################
### AUTH
######################################
AUTH_GUARD=web
AUTH_PASSWORD_BROKER=users
AUTH_PASSWORD_RESET_TOKEN_TABLE=password_reset_tokens
AUTH_PASSWORD_RESET_TOKEN_EXPIRE=120
AUTH_PASSWORD_RESET_TOKEN_THROTTLE=30
AUTH_PASSWORD_TIMEOUT=120
# Shorter-lived tokens for web clients requiring frequent renewals
AUTH_TOKEN_LIFETIME_WEB=7200
# Longer-lived tokens for mobile clients reducing renewal burden
AUTH_TOKEN_LIFETIME_MOBILE=7776000

######################################
### DATABASE CONNECTION
######################################
DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3333
DB_DATABASE=portfolio
DB_USERNAME=admin
DB_PASSWORD=secret

######################################
### DOCKER COMPOSER
######################################
WWWGROUP=1000
WWWUSER=1000

######################################
### LOCALE
######################################
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB

######################################
### LOGGING
######################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=21
LOG_SLACK_USERNAME='Laravel Log'
